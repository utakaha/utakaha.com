<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <id><%= feed_url %></id>
  <title><%= ERB::Util.html_escape(feed_title) %></title>
  <updated><%= feed_updated_at.iso8601 %></updated>
  <author>
    <name><%= ERB::Util.html_escape(feed_author) %></name>
  </author>
  <link rel="self" type="application/atom+xml" href="<%= feed_url %>" />
  <link rel="alternate" type="text/html" href="<%= base_url %>/" />
<% posts.each do |post| %>
  <entry>
    <id><%= post.feed_id %></id>
    <title><%= ERB::Util.html_escape(post.title) %></title>
    <published><%= post.published_at.iso8601 %></published>
    <updated><%= post.published_at.iso8601 %></updated>
    <summary><%= ERB::Util.html_escape(post.summary) %></summary>
    <link rel="alternate" type="text/html" href="<%= post.url %>" />
  </entry>
<% end %>
</feed>
