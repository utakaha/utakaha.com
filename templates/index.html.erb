<!DOCTYPE html>
<html lang="ja">
  <head>
    <%= render_partial "head" %>
  </head>

  <body>
    <%= render_partial "header" %>

    <main>
      <section class="section">
        <h2 class="section-title">
          <span class="title">Posts</span>
        </h2>
        <ul>
          <% posts.each do |post| %>
            <li>
              <span>
                <%= post.date %>
                &nbsp;&nbsp;
              </span>
              <a href="/posts/<%= post.slug %>.html">
                <%= post.title %>
              </a>
            </li>
          <% end %>
        </ul>
      </section>

      <section class="section">
        <h2 class="section-title">
          <span class="title">About</span>
        </h2>
        <div class="identity">
          <div class="identity-icon">
            <img src="/assets/images/icon.webp" alt="アイコン" class="icon" width="300" height="300" fetchpriority="high">
          </div>
          <div class="identity-content">
            <div>
              <h3 class="sub-section-title">Links</h3>
              <ul>
                <li><a href="https://twitter.com/utakaha">Twitter</a></li>
                <li><a href="https://github.com/utakaha">GitHub</a></li>
                <li><a href="https://www.linkedin.com/in/utakaha">LinkedIn</a></li>
                <li><a href="https://unsplash.com/@utakaha">Unsplash</a></li>
              </ul>
            </div>
          </div>
        </div>
      </section>
    </main>

    <%= render_partial "footer" %>
  </body>
</html>
