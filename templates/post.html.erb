<!DOCTYPE html>
<html lang="ja">
  <head>
    <%= render_partial "head" %>
  </head>
  <body>
    <%= render_partial "header" %>
    <h1 class="post-title">
      <span class="title"><%= title %></span>
    </h1>
    <div class="date"><%= date %></div>
    <main class="content">
      <%= content %>
    </main>
    <%= render_partial "footer" %>
  </body>
</html>
