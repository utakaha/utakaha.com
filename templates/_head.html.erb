<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link rel="stylesheet" href="/assets/styles.css">
  <link rel="stylesheet" href="/assets/syntax.css">
  <link rel="alternate" type="application/atom+xml" title="@utakaha Atom Feed" href="https://utakaha.com/feed">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
  <link rel="icon" type="image/webp" href="/assets/images/icon.webp" sizes="128x128">
  <link rel="apple-touch-icon" href="/assets/images/icon.webp">

  <link rel="preload" href="/assets/NotoSansJP-Regular.ttf" as="font" type="font/ttf" crossorigin>
  <link rel="preload" href="/assets/NotoSansJP-Bold.ttf" as="font" type="font/ttf" crossorigin>

  <meta property="og:site_name" content="@utakaha" />
  <meta property="og:title" content="<%= title %>" />
  <meta property="og:image" content="https://utakaha.com/assets/images/icon.jpg" />
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="<%= title %>">
  <meta name="twitter:image" content="https://utakaha.com/assets/images/icon.jpg">
</head>
